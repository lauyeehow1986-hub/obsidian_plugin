{
  "name": "scdb-cockpit",
  "version": "0.1.0",
  "description": "Operating system for research data governance and facility operations, in Obsidian.",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs --dev",
    "build": "tsc --noEmit && node esbuild.config.mjs --prod",
    "package": "npm run build && npm run smoke && node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian-plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "preact": "^10.25.4"
  }
}
